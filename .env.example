# Public MCP resource and network boundary
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_RESOURCE_URI=https://quickbooks-mcp.devraftel.com/mcp
MCP_ALLOWED_HOSTS=quickbooks-mcp.devraftel.com
MCP_ALLOWED_ORIGINS=approved-browser-client.example
MCP_BODY_LIMIT=3mb
MCP_REQUEST_TIMEOUT_MS=30000
MCP_RATE_LIMIT_PER_MINUTE=120

# Provider-neutral MCP OAuth resource-server configuration
MCP_AUTH_ISSUER=https://authorization-server.example/issuer
MCP_AUTH_METADATA_URL=https://authorization-server.example/.well-known/oauth-authorization-server
MCP_AUTH_INTROSPECTION_URL=https://authorization-server.example/introspect
MCP_AUTH_INTROSPECTION_CLIENT_ID=...
MCP_AUTH_INTROSPECTION_CLIENT_SECRET=...

# AuthCo supplies exactly one organization claim. QuickBooks connection
# selection is resolved by the authenticated lease provider after verification;
# no connection, realm ID, company ID, or credential claim is accepted here.
MCP_AUTH_ORGANIZATION_CLAIM=https://devraftel.com/organization_id

# Request-state and operation fingerprints. Generate independent 32-byte keys:
# openssl rand -base64 32
MCP_REQUEST_STATE_KEY=replace-with-base64-encoded-32-byte-key
MCP_OPERATION_FINGERPRINT_KEY=replace-with-another-base64-encoded-32-byte-key
MCP_OPERATION_FINGERPRINT_KEY_VERSION=v1

# Required provider adapters. The MCP package defines ports; deployment code
# supplies authenticated implementations without a repository-owned network
# protocol or credential store.
QBO_EXECUTION_LEASE_PROVIDER=devraftel-connection-service
OPERATION_LEDGER_PROVIDER=devraftel-execution-ledger
RATE_LIMIT_PROVIDER=devraftel-rate-limiter
MCP_WORKLOAD_IDENTITY=quickbooks-mcp-production

# Optional deployment-wide incident brakes. These suppress registration only;
# they are not tenant authorization.
# QUICKBOOKS_DISABLE_WRITE=true
# QUICKBOOKS_DISABLE_UPDATE=true
# QUICKBOOKS_DISABLE_DELETE=true
