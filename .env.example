# Public MCP resource and network boundary
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_RESOURCE_URI=https://quickbooks-mcp.devraftel.com/mcp
MCP_ALLOWED_HOSTS=quickbooks-mcp.devraftel.com
MCP_ALLOWED_ORIGINS=approved-browser-client.example
MCP_BODY_LIMIT=3mb
MCP_REQUEST_TIMEOUT_MS=30000

# How callers authenticate. `shared-secret`: the Finance worker is the only
# caller and presents MCP_SHARED_SECRET as its bearer, compared in constant
# time; organization and company arrive in per-call MCP metadata. `oauth`
# (the default) introspects bearer tokens at AuthCo and applies the client
# allowlist below. The two are selected here and nowhere else.
MCP_AUTH_MODE=shared-secret
# Required in shared-secret mode: 32+ characters, no whitespace, and the same
# value as QUICKBOOKS_MCP_SHARED_SECRET in finance-ai-employees.
MCP_SHARED_SECRET=replace-with-dedicated-random-shared-secret

# --- oauth mode only ---------------------------------------------------------
# Read only when MCP_AUTH_MODE=oauth. Tokens are introspected, never verified
# locally against a JWKS, so that revocation and live organization membership
# are enforced on every call. MCP_AUTH_JWKS_URL must stay unset; startup
# rejects it if present. In shared-secret mode MCP_AUTH_ISSUER and
# MCP_AUTH_ORGANIZATION_CLAIM may be left unset and default to constants.
MCP_AUTH_ISSUER=https://authorization-server.example/issuer
MCP_AUTH_METADATA_URL=https://authorization-server.example/.well-known/oauth-authorization-server
MCP_AUTH_INTROSPECTION_URL=https://authorization-server.example/introspect
MCP_AUTH_INTROSPECTION_CLIENT_ID=...
MCP_AUTH_INTROSPECTION_CLIENT_SECRET=...

# AuthCo supplies exactly one organization claim. QuickBooks connection
# selection is resolved by the authenticated lease provider after verification;
# no connection, realm ID, company ID, or credential claim is accepted here.
MCP_AUTH_ORGANIZATION_CLAIM=https://devraftel.com/organization_id

# Comma-separated OAuth client ids allowed to reach this resource server.
# oauth mode only; shared-secret mode fixes the caller to finance-worker.
# Required unless MCP_TEMPORARY_UNAUTHENTICATED_MODE is true. The audience
# alone does not say who is calling: AuthCo will mint a token for this resource
# for any client a user consents to, so without this list a third-party client
# could carry that user's organization through to Finance's lease endpoint.
# `*` is rejected. It is not enforced while MCP_TEMPORARY_UNAUTHENTICATED_MODE
# is true, because that mode fabricates a caller that is not a real client;
# setting it during the cutover window is correct and simply has no effect yet.
MCP_AUTH_ALLOWED_CLIENT_IDS=finance-worker

# TEMPORARY sandbox-only bypass. When true, /mcp accepts requests without a
# bearer and reads organization/company selectors from per-call MCP metadata.
# Keep false by default and restore false after the integration window. It
# cannot be combined with MCP_AUTH_MODE=shared-secret.
MCP_TEMPORARY_UNAUTHENTICATED_MODE=false

# Finance-backed QuickBooks execution-lease provider. The workload token is a
# dedicated service credential shared with Finance, never an Intuit credential.
QBO_EXECUTION_LEASE_PROVIDER=finance-http
FINANCE_QUICKBOOKS_INTERNAL_URL=http://finance-backend:8000
FINANCE_QUICKBOOKS_WORKLOAD_TOKEN=replace-with-dedicated-random-workload-token
FINANCE_QUICKBOOKS_ENVIRONMENT=sandbox
FINANCE_QUICKBOOKS_TIMEOUT_MS=5000

# Optional deployment-wide incident brakes. These suppress registration only;
# they are not tenant authorization.
# QUICKBOOKS_DISABLE_WRITE=true
# QUICKBOOKS_DISABLE_UPDATE=true
# QUICKBOOKS_DISABLE_DELETE=true
