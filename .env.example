# Public MCP resource and network boundary
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_RESOURCE_URI=https://mcp.example.com/mcp
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=approved-browser-client.example
MCP_BODY_LIMIT=3mb
MCP_REQUEST_TIMEOUT_MS=30000
MCP_RATE_LIMIT_PER_MINUTE=120

# Provider-neutral MCP OAuth resource-server configuration
MCP_AUTH_ISSUER=https://authorization-server.example/issuer
MCP_AUTH_METADATA_URL=https://authorization-server.example/.well-known/oauth-authorization-server
MCP_AUTH_JWKS_URL=https://authorization-server.example/jwks
# For opaque tokens, remove MCP_AUTH_JWKS_URL and configure all three below.
# MCP_AUTH_INTROSPECTION_URL=https://authorization-server.example/introspect
# MCP_AUTH_INTROSPECTION_CLIENT_ID=...
# MCP_AUTH_INTROSPECTION_CLIENT_SECRET=...

# Bind authorized callers to this deployment's QuickBooks company. The claim
# name and values come from the configured authorization server; no vendor claim
# is assumed by the application.
MCP_AUTH_BINDING_CLAIM=organization_id
MCP_AUTH_ALLOWED_BINDING_VALUES=replace-with-authorized-organization-id

# Shared durable runtime. Generate each key independently, for example:
# openssl rand -base64 32
DATABASE_URL=postgresql://user:password@database.example:5432/qbo_mcp?sslmode=require
MCP_DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
MCP_REQUEST_STATE_KEY=replace-with-another-base64-encoded-32-byte-key

# Intuit application credentials and logical connection identifier
QUICKBOOKS_CONNECTION_ID=primary-company
QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here

# One-time database bootstrap only. Supply all three together for the first
# deployment, then remove them after quickbooks_connections has been created.
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REALM_ID=your_company_id_here
QUICKBOOKS_REFRESH_TOKEN=your_refresh_token_here

# Optional tool-surface restriction. These suppress registration entirely.
# QUICKBOOKS_DISABLE_WRITE=true
# QUICKBOOKS_DISABLE_UPDATE=true
# QUICKBOOKS_DISABLE_DELETE=true
